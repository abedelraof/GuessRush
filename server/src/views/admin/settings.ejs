<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Settings' }) %></head>
<body>
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { active: 'settings' }) %>
    <main class="flex-1 p-8 max-w-2xl space-y-8">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900">Settings</h1>
        <p class="text-slate-500 text-sm mt-1">Manage your admin account and integrations.</p>
      </div>

      <section>
        <h2 class="text-base font-bold text-slate-900 mb-3">Account</h2>
        <div class="card p-6">
          <% if (accountError) { %>
            <div class="alert-error mb-4"><span>⚠️</span><span><%= accountError %></span></div>
          <% } %>
          <% if (accountSuccess) { %>
            <div class="alert-success mb-4"><span>✓</span><span><%= accountSuccess %></span></div>
          <% } %>
          <form method="post" action="/admin/settings/account" class="space-y-4">
            <div>
              <label class="field-label">Email</label>
              <input class="field-input" type="email" name="email" required value="<%= account.email %>">
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="field-label">New password</label>
                <input class="field-input" type="password" name="new_password" autocomplete="new-password" minlength="8">
                <p class="text-xs text-slate-400 mt-1">Leave blank to keep current</p>
              </div>
              <div>
                <label class="field-label">Confirm new password</label>
                <input class="field-input" type="password" name="confirm_password" autocomplete="new-password" minlength="8">
              </div>
            </div>
            <div class="border-t border-slate-100 pt-4">
              <label class="field-label">Current password <span class="font-normal text-slate-400">(required to save changes)</span></label>
              <input class="field-input max-w-xs" type="password" name="current_password" required autocomplete="current-password">
            </div>
            <button class="btn-primary" type="submit">Save account</button>
          </form>
        </div>
      </section>

      <section>
        <h2 class="text-base font-bold text-slate-900 mb-3">Claude API key</h2>
        <div class="card p-6">
          <p class="text-sm text-slate-500 mb-4">
            Used for AI-assisted features. Stored encrypted — the full key is never shown again after saving.
          </p>
          <% if (claudeKeyError) { %>
            <div class="alert-error mb-4"><span>⚠️</span><span><%= claudeKeyError %></span></div>
          <% } %>
          <% if (claudeKeySuccess) { %>
            <div class="alert-success mb-4"><span>✓</span><span><%= claudeKeySuccess %></span></div>
          <% } %>

          <% if (maskedClaudeKey) { %>
            <div class="flex items-center justify-between gap-4 rounded-lg bg-slate-50 border border-slate-200 px-4 py-3 mb-4">
              <div class="min-w-0">
                <div class="text-xs text-slate-500 mb-0.5">Current key</div>
                <div class="font-mono text-sm text-slate-700 truncate"><%= maskedClaudeKey %></div>
              </div>
              <form method="post" action="/admin/settings/claude-key/remove" onsubmit="return confirm('Remove the saved Claude API key?');" class="shrink-0">
                <button class="btn-danger" type="submit">Remove</button>
              </form>
            </div>
          <% } %>

          <form method="post" action="/admin/settings/claude-key">
            <div class="flex items-end gap-3">
              <div class="flex-1">
                <label class="field-label"><%= maskedClaudeKey ? 'Replace key' : 'API key' %></label>
                <input class="field-input font-mono" type="password" name="api_key" placeholder="sk-ant-..." autocomplete="off">
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-200">
              <label class="field-label">Workspace ID <span class="font-normal text-slate-400">(optional)</span></label>
              <p class="text-xs text-slate-500 mb-2">
                Only needed if the key above is an <em>identity-linked</em> key from the Anthropic Console —
                those are rejected with an "anthropic-workspace-id is required" error unless this is set.
                Find it in the Anthropic Console under the workspace this key should act in. A classic
                workspace-scoped key doesn't need this at all.
              </p>
              <input class="field-input font-mono" type="text" name="workspace_id" value="<%= workspaceId || '' %>" placeholder="wrkspc_...">
            </div>

            <button class="btn-primary mt-4" type="submit">Save</button>
          </form>
        </div>
      </section>

      <section>
        <h2 class="text-base font-bold text-slate-900 mb-3">Custom AI key</h2>
        <div class="card p-6">
          <p class="text-sm text-slate-500 mb-4">
            Used for AI-generated question audio (text-to-speech), option images, and video clips. Stored encrypted — the full key is never shown again after saving.
          </p>
          <% if (ttsKeyError) { %>
            <div class="alert-error mb-4"><span>⚠️</span><span><%= ttsKeyError %></span></div>
          <% } %>
          <% if (ttsKeySuccess) { %>
            <div class="alert-success mb-4"><span>✓</span><span><%= ttsKeySuccess %></span></div>
          <% } %>

          <% if (maskedTtsKey) { %>
            <div class="flex items-center justify-between gap-4 rounded-lg bg-slate-50 border border-slate-200 px-4 py-3 mb-4">
              <div class="min-w-0">
                <div class="text-xs text-slate-500 mb-0.5">Current key</div>
                <div class="font-mono text-sm text-slate-700 truncate"><%= maskedTtsKey %></div>
              </div>
              <form method="post" action="/admin/settings/tts-key/remove" onsubmit="return confirm('Remove the saved Custom AI key?');" class="shrink-0">
                <button class="btn-danger" type="submit">Remove</button>
              </form>
            </div>
          <% } %>

          <form method="post" action="/admin/settings/tts-key" class="flex items-end gap-3">
            <div class="flex-1">
              <label class="field-label"><%= maskedTtsKey ? 'Replace key' : 'API key' %></label>
              <input class="field-input font-mono" type="password" name="api_key" placeholder="..." autocomplete="off">
            </div>
            <button class="btn-primary" type="submit">Save key</button>
          </form>
        </div>
      </section>

      <section>
        <h2 class="text-base font-bold text-red-700 mb-3">Danger zone</h2>
        <div class="card p-6 border-2 border-red-200">
          <p class="text-sm text-slate-500 mb-4">
            Permanently deletes every player, question, game session, answer, achievement, mission record,
            and daily-rush record. <strong class="text-slate-700">Categories, admin accounts, and saved API
            keys are kept</strong> — this resets player/game data, not the app's own setup.
            <strong class="text-red-700">This cannot be undone.</strong>
          </p>
          <% if (dangerZoneError) { %>
            <div class="alert-error mb-4"><span>⚠️</span><span><%= dangerZoneError %></span></div>
          <% } %>
          <% if (dangerZoneSuccess) { %>
            <div class="alert-success mb-4"><span>✓</span><span><%= dangerZoneSuccess %></span></div>
          <% } %>
          <form method="post" action="/admin/settings/clear-data" id="clear-data-form" class="space-y-4">
            <div>
              <label class="field-label">Current password</label>
              <input class="field-input max-w-xs" type="password" name="current_password" required autocomplete="current-password">
            </div>
            <div>
              <label class="field-label">Type <span class="font-mono font-bold">DELETE ALL DATA</span> to confirm</label>
              <input class="field-input max-w-xs font-mono" type="text" name="confirm_phrase" id="confirm-phrase-input" required autocomplete="off">
            </div>
            <button class="btn-danger" type="submit" id="clear-data-submit" disabled>Clear all data</button>
          </form>
        </div>
      </section>
    </main>
  </div>

  <script>
    (function () {
      const REQUIRED_PHRASE = 'DELETE ALL DATA';
      const input = document.getElementById('confirm-phrase-input');
      const btn = document.getElementById('clear-data-submit');
      const form = document.getElementById('clear-data-form');
      if (!input || !btn || !form) return;

      input.addEventListener('input', () => {
        btn.disabled = input.value !== REQUIRED_PHRASE;
      });

      form.addEventListener('submit', (e) => {
        const warned = confirm(
          'This permanently deletes every player, question, game session, and answer. ' +
          'Categories, admin accounts, and API keys are kept. This cannot be undone. Continue?'
        );
        if (!warned) e.preventDefault();
      });
    })();
  </script>
</body>
</html>
