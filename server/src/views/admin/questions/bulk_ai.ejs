<!doctype html>
<html lang="en">
<head><%- include('../../partials/head', { title: 'Bulk AI Questions' }) %></head>
<body>
  <div class="flex min-h-screen">
    <%- include('../../partials/sidebar', { active: 'questions' }) %>
    <main class="flex-1 p-8 max-w-2xl">
      <a href="/admin/questions" class="text-sm text-slate-500 hover:text-slate-700">← Back to questions</a>
      <h1 class="text-2xl font-extrabold text-slate-900 mt-2 mb-1">🌙 Bulk AI Questions</h1>
      <p class="text-slate-500 text-sm mb-6">
        Runs the same Generate → review → Save flow you'd do by hand, batch after batch, until the
        target count is reached — using the real pages, so you can watch it happen. Keep this tab
        open until it finishes; the status bar at the top tracks progress on every page.
      </p>

      <% if (!hasClaudeKey || !hasTtsKey) { %>
        <div class="alert-error mb-5">
          <span>⚠️</span>
          <span>
            <% if (!hasClaudeKey) { %>Add a Claude API key<% } %>
            <% if (!hasClaudeKey && !hasTtsKey) { %> and a Custom AI Key<% } else if (!hasTtsKey) { %>Add a Custom AI Key<% } %>
            in Settings first — every batch would otherwise draft text with no audio/images/video.
            <a href="/admin/settings" class="underline font-semibold">Go to Settings →</a>
          </span>
        </div>
      <% } %>

      <div id="already-running-card" class="card p-6 hidden">
        <p class="text-sm text-slate-700 mb-4">A run is already in progress or paused — use the status bar above to Pause, Resume, or Stop it.</p>
        <button type="button" id="discard-run-btn" class="btn-danger">Discard this run</button>
      </div>

      <div id="start-section" class="card p-6">
        <div class="space-y-5">
          <div>
            <label class="field-label">How many questions total?</label>
            <input type="number" id="target-count" min="1" value="100" class="field-input max-w-xs" <%= (!hasClaudeKey || !hasTtsKey) ? 'disabled' : '' %>>
          </div>

          <div>
            <label class="field-label mb-2">Category</label>
            <div class="flex items-center gap-4 mb-3">
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                <input type="radio" name="mode" id="mode-single" value="single" checked class="accent-brand-500" <%= (!hasClaudeKey || !hasTtsKey) ? 'disabled' : '' %>>
                One category
              </label>
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                <input type="radio" name="mode" id="mode-split" value="split" class="accent-brand-500" <%= (!hasClaudeKey || !hasTtsKey) ? 'disabled' : '' %>>
                Split evenly across all categories
              </label>
            </div>
            <div id="category-select-wrap">
              <select id="category-select" class="field-select max-w-xs" <%= (!hasClaudeKey || !hasTtsKey) ? 'disabled' : '' %>>
                <% categories.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.emoji %> <%= c.name %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <button type="button" id="start-btn" class="btn-primary" <%= (!hasClaudeKey || !hasTtsKey) ? 'disabled' : '' %>>Start</button>
        </div>
      </div>
    </main>
  </div>

  <script>
    var CATEGORIES = <%- JSON.stringify(categories) %>;
    var MAX_GENERATE_COUNT = <%= maxGenerateCount %>;

    // Waits for DOMContentLoaded — not just for the elements above (already
    // parsed by the time this inline script runs), but because this code
    // calls into window.BulkAiRunner, which is defined by the deferred
    // bulk-ai-runner.js. Deferred scripts only run once parsing finishes,
    // which is *after* a plain inline script like this one would otherwise
    // run — so without this wrapper, window.BulkAiRunner could still be
    // undefined here.
    document.addEventListener('DOMContentLoaded', function () {

    document.getElementById('mode-single').addEventListener('change', syncModeUI);
    document.getElementById('mode-split').addEventListener('change', syncModeUI);
    function syncModeUI() {
      var isSingle = document.getElementById('mode-single').checked;
      document.getElementById('category-select-wrap').classList.toggle('hidden', !isSingle);
    }
    syncModeUI();

    document.getElementById('start-btn').addEventListener('click', function () {
      var targetCount = Number(document.getElementById('target-count').value);
      if (!Number.isInteger(targetCount) || targetCount < 1) {
        alert('Enter a valid number of questions.');
        return;
      }
      var mode = document.getElementById('mode-single').checked ? 'single' : 'split';
      var categoryId = mode === 'single' ? document.getElementById('category-select').value : null;

      var batches = window.BulkAiRunner.computeBatches(mode, categoryId, targetCount, CATEGORIES, MAX_GENERATE_COUNT)
        .map(function (b, i) { b.index = i; b.error = null; return b; });

      var run = {
        version: 2,
        startedAt: new Date().toISOString(),
        targetCount: targetCount,
        mode: mode,
        categoryId: categoryId,
        batches: batches,
        currentBatchIndex: 0,
        runState: 'running',
        expecting: null,
        log: [{ ts: new Date().toISOString(), level: 'info', message: 'Starting run: ' + targetCount + ' question(s) across ' + batches.length + ' batch(es).' }],
      };

      var startBtn = document.getElementById('start-btn');
      startBtn.disabled = true;
      startBtn.textContent = 'Starting…';

      // startRun() ends in a real form.submit() (a full page navigation), which
      // can happen before the browser gets a chance to paint the disabled/label
      // change above — without this tick, the click can look like it did
      // nothing until the new page suddenly appears.
      setTimeout(function () {
        window.BulkAiRunner.startRun(run);
      }, 30);
    });

    document.getElementById('discard-run-btn').addEventListener('click', function () {
      if (!confirm('Discard this run? Already-saved questions are not affected.')) return;
      window.BulkAiRunner.clearRun();
      window.location.reload();
    });

    (function initPage() {
      var run = window.BulkAiRunner.loadRun();
      if (run && run.runState !== 'completed') {
        document.getElementById('start-section').classList.add('hidden');
        document.getElementById('already-running-card').classList.remove('hidden');
      }
    })();

    }); // DOMContentLoaded
  </script>
</body>
</html>
