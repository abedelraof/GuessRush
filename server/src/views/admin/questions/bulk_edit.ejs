<!doctype html>
<html lang="en">
<head><%- include('../../partials/head', { title: 'Bulk edit questions' }) %></head>
<body>
  <div class="flex min-h-screen">
    <%- include('../../partials/sidebar', { active: 'questions' }) %>
    <main class="flex-1 p-8 max-w-2xl">
      <a href="/admin/questions" class="text-sm text-slate-500 hover:text-slate-700">← Back to questions</a>
      <h1 class="text-2xl font-extrabold text-slate-900 mt-2 mb-2">Bulk edit questions</h1>
      <p class="text-slate-500 text-sm mb-6">
        Applying to <%= questions.length %> question<%= questions.length === 1 ? '' : 's' %>.
        Leave a field blank/unselected to keep it as-is on every question — only what you fill in here gets changed.
      </p>

      <% if (error) { %>
        <div class="alert-error mb-5">
          <span>⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="card p-6 mb-6">
        <form method="post" action="/admin/questions/bulk-edit/confirm" class="space-y-6">
          <% ids.forEach(function(id) { %>
            <input type="hidden" name="ids" value="<%= id %>">
          <% }); %>

          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="field-label">Category</label>
              <select name="category_id" class="field-select">
                <option value="">— Don't change —</option>
                <% categories.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.emoji %> <%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <label class="field-label">Difficulty</label>
              <select name="difficulty" class="field-select">
                <option value="">— Don't change —</option>
                <% difficulties.forEach(function(d) { %>
                  <option value="<%= d %>"><%= d %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <label class="field-label">Timer (s)</label>
              <input type="number" name="timer_seconds" min="0" class="field-input" placeholder="Don't change">
            </div>
          </div>

          <button class="btn-primary" type="submit">Apply to <%= questions.length %> question<%= questions.length === 1 ? '' : 's' %></button>
        </form>
      </div>

      <div class="card overflow-hidden">
        <table class="table-base">
          <thead>
            <tr>
              <th>Type</th>
              <th>Difficulty</th>
              <th>Category</th>
              <th>Prompt</th>
            </tr>
          </thead>
          <tbody>
            <% questions.forEach(function(q) { %>
              <tr>
                <td><span class="badge-brand"><%= q.type %></span></td>
                <td><span class="badge-brand"><%= q.difficulty %></span></td>
                <td class="text-slate-600"><%= q.category_name %></td>
                <td class="max-w-sm truncate"><%= q.prompt %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
