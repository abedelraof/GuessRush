<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Dashboard' }) %></head>
<body>
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { active: 'dashboard' }) %>
    <main class="flex-1 p-8 max-w-5xl">
      <h1 class="text-2xl font-extrabold text-slate-900 mb-1">Dashboard</h1>
      <p class="text-slate-500 text-sm mb-6">Overview of your quiz content and players.</p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card p-5">
          <div class="text-3xl">🗂️</div>
          <div class="text-3xl font-extrabold text-slate-900 mt-3"><%= counts.categories %></div>
          <div class="text-sm text-slate-500">Categories</div>
        </div>
        <div class="card p-5">
          <div class="text-3xl">❓</div>
          <div class="text-3xl font-extrabold text-slate-900 mt-3"><%= counts.questions %></div>
          <div class="text-sm text-slate-500">Questions</div>
        </div>
        <a href="/admin/players" class="card p-5 block hover:border-brand-300">
          <div class="text-3xl">🧑‍🤝‍🧑</div>
          <div class="text-3xl font-extrabold text-slate-900 mt-3"><%= counts.players %></div>
          <div class="text-sm text-slate-500">Players</div>
        </a>
        <div class="card p-5">
          <div class="text-3xl">🎮</div>
          <div class="text-3xl font-extrabold text-slate-900 mt-3"><%= counts.sessions %></div>
          <div class="text-sm text-slate-500">Game sessions</div>
        </div>
      </div>

      <div class="mt-8 flex gap-3">
        <a href="/admin/categories/new" class="btn-primary">+ New category</a>
        <a href="/admin/questions/new" class="btn-secondary">+ New question</a>
      </div>

      <div class="card p-6 mt-8">
        <h2 class="font-bold text-slate-900 mb-4">Retention</h2>
        <div class="flex items-center gap-8">
          <div>
            <div class="text-2xl font-extrabold text-slate-900">🔥 <%= activeStreaks %></div>
            <div class="text-xs text-slate-500">Players with an active daily streak</div>
          </div>
          <div class="flex-1">
            <div class="text-xs text-slate-500 mb-2">Active events</div>
            <% if (activeEvents.length === 0) { %>
              <div class="text-sm text-slate-400">None right now</div>
            <% } else { %>
              <div class="flex flex-wrap gap-2">
                <% activeEvents.forEach(function(e) { %>
                  <span class="badge-brand"><%= e.name %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
